<Window x:Class="CyberSecurityBot2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityBot2"
        mc:Ignorable="d"
        Title="CyberSecurityBot"
        Height="500" Width="800"
        Background="#F5F7FB">      
    <!-- Colors & Styles -->
    <Window.Resources>

        <!-- Main Colors -->
        <SolidColorBrush x:Key="Primary" Color="#4F46E5"/>
        <SolidColorBrush x:Key="Background" Color="#F5F7FB"/>
        <SolidColorBrush x:Key="Card" Color="White"/>
        <SolidColorBrush x:Key="TextDark" Color="#1F2937"/>
        <SolidColorBrush x:Key="Error" Color="#EF4444"/>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

    </Window.Resources>
    <Grid>

        <!-- ================= HOME PAGE ================= -->
        <Grid x:Name="home_grid" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <Image Source="/logo.png"
                       Height="180"
                       Width="260"
                       Margin="0,0,0,20"/>

                <TextBlock Text="Welcome to CyberSecurityBot"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDark}"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Your friendly AI assistant for cybersecurity help"
                           FontSize="14"
                           Foreground="#6B7280"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <Button Content="Get Started"
                        Width="200"
                        Click="proceed"/>
            </StackPanel>
        </Grid>

        <!-- ================= USERNAME PAGE ================= -->
        <Grid x:Name="username_grid" Visibility="Hidden">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <Image Source="/logo.png"
                       Height="160"
                       Width="240"
                       Margin="0,0,0,20"/>

                <TextBlock Text="Enter your name?"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextDark}"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="usernames_input"
                         Width="260"
                         Height="40"
                         TextAlignment="Center"/>

                <TextBlock x:Name="error_message"
                           Text="Please enter your username to continue"
                           Foreground="{StaticResource Error}"
                           Visibility="Hidden"
                           TextAlignment="Center"
                           Margin="0,5,0,0"/>

                <Button Content="Continue"
                        Width="200"
                        Margin="0,15,0,0"
                        Click="submit_name"/>
            </StackPanel>
        </Grid>

        <!-- ================= CHAT PAGE ================= -->
        <Grid x:Name="chat_grid" Visibility="Hidden">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat list -->
            <ListView x:Name="chats"
                      Grid.Row="0"
                      Margin="10"
                      Background="White"
                      BorderBrush="#E5E7EB"/>

            <!-- Input area -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="10">

                <TextBox x:Name="question"
                         Width="500"
                         Height="40"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>

                <Button Content="Send"
                        Width="120"
                        Height="40"
                        Click="send"/>
            </StackPanel>

        </Grid>

    </Grid>
</Window>
